log_forwarder.py (local development için):
pythonimport time
import requests

N8N_WEBHOOK_URL = "http://localhost:5678/webhook-test/cooja-logs"
LOG_FILE_PATH = r"\\wsl$\Ubuntu\home\omer\contiki-ng\cooja_events.log"

def watch_log_file():
    print("🚀 NetOps Log Köprüsü Başlatıldı.")
    with open(LOG_FILE_PATH, "r", encoding="utf-8", errors="ignore") as f:
        f.seek(0, 2)
        while True:
            line = f.readline()
            if not line:
                time.sleep(0.5)
                continue
            clean_line = line.strip()
            if clean_line and ("ID:" in clean_line or "INFO:" in clean_line):
                print(f"📦 n8n'e gönderiliyor: {clean_line}")
                payload = {"log_line": clean_line}
                try:
                    response = requests.post(N8N_WEBHOOK_URL, json=payload, timeout=2)
                    print(f"✅ n8n cevabı: {response.status_code}")
                except requests.exceptions.RequestException as e:
                    print(f"❌ Bağlantı hatası: {e}")

if __name__ == "__main__":
    watch_log_file()

