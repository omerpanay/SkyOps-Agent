Node 7 — LLM Output Parser (Code Node)
javascriptconst raw = $json.choices[0].message.content;
const clean = raw.replace(/```json|```/g, '').trim();
const parsed = JSON.parse(clean);
return [{
  json: {
    ...parsed,
    method: 'LLM_GROQ',
    affected_node: `Node #${$json.node_id || '?'}`
  }
}];
